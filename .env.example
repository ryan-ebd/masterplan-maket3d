# --- Database (docker compose via OrbStack, port host 5433!) ---
DATABASE_URL="postgresql://maket:maket_dev_pw@localhost:5433/maket3d?schema=public"

# --- Auth.js v5 ---
# generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- Google Maps Platform ---
# Key CLIENT untuk Maps JavaScript API (restrict HTTP referrer di Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Map ID untuk AdvancedMarker (boleh "DEMO_MAP_ID" saat dev)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"
# Key SERVER untuk Geocoding + Elevation API.
# WAJIB Application restrictions = None atau IP address — JANGAN HTTP referrer:
# web service API dipanggil server-ke-server tanpa referrer, key ber-referrer selalu REQUEST_DENIED.
GOOGLE_MAPS_SERVER_KEY=""

# --- Anthropic (server-only) ---
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-sonnet-5"

# --- Storage hasil pipeline 3D ---
STORAGE_DIR="./storage/models"

# --- BytePlus ModelArk / Seedance (server-only, video tur maket) ---
# Key dari konsol BytePlus ModelArk (API key). JANGAN diawali NEXT_PUBLIC_.
# Model 2.0/2.5 mensyaratkan saldo kredit >= $30 agar aktif (dokumen BytePlus).
ARK_API_KEY=""
# Opsional — default region ap-southeast:
# ARK_BASE_URL="https://ark.ap-southeast.bytepluses.com/api/v3"
# Opsional — default dreamina-seedance-2-0-260128. Untuk menyetel prompt murah:
#   dreamina-seedance-2-0-mini-260615 (480p) lalu kembali ke default untuk hasil akhir.
# SEEDANCE_MODEL="dreamina-seedance-2-0-260128"
# SEEDANCE_RESOLUTION="720p"
# SEEDANCE_DURASI_DTK="5"
