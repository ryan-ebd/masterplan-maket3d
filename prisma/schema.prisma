generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  KLIEN
  PERENCANA
  ADMIN
}

enum ProjectStatus {
  BARU
  DIPROSES
  GENERATING
  REVIEW_PERENCANA
  SELESAI
  GAGAL
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  ERROR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  projects     Project[] @relation("KlienProjects")
  assigned     Project[] @relation("PerencanaProjects")
  createdAt    DateTime  @default(now())
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(BARU)

  // Titik lokasi dari Klien (picker Google Maps)
  locationLat Float
  locationLng Float
  address     String? // hasil reverse-geocoding (boleh null jika gagal)

  // Poligon wilayah hasil kerja Perencana (+LLM)
  boundary     Json? // GeoJSON Polygon, ring tertutup, [lng,lat]
  boundaryNote String? // alasan/anotasi dari LLM atau perencana
  areaM2       Float? // luas terhitung, untuk validasi batas maks
  zonesMeta    Json? // suggested_zones dari LLM: [{name, type}]
  roofDefaults Json? // roof_defaults dari LLM: [{zone_type, shape, pitch_deg, note}]

  klien       User    @relation("KlienProjects", fields: [klienId], references: [id])
  klienId     String
  perencana   User?   @relation("PerencanaProjects", fields: [perencanaId], references: [id])
  perencanaId String?

  jobs        ProcessingJob[]
  model       Model3D?
  llmSessions LlmSession[]
  titikTur    TitikTur[]
  klipTur     KlipTur[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([klienId])
  @@index([perencanaId])
  @@index([status])
}

model ProcessingJob {
  id        String    @id @default(cuid())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  status    JobStatus @default(QUEUED)
  step      String? // "fetch-osm" | "fetch-heights" | "fetch-elevation" | "build-geometry" | "export-glb"
  progress  Int       @default(0) // 0..100
  error     String?
  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  // Kunci idempotensi: diisi projectId selama job aktif (QUEUED/RUNNING), di-null-kan saat selesai.
  // Unique membuat "satu job aktif per proyek" dijamin DATABASE, bukan cek-lalu-buat yang bisa balapan.
  activeKey String? @unique

  @@index([projectId, createdAt])
  @@index([status])
}

model Model3D {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String   @unique
  glbPath    String // relatif STORAGE_DIR: {projectId}/{uuid}.glb
  stats      Json // {buildings, roads, waterBodies, areaM2, features?, warnings?}
  layersMeta Json // [{id, label, nodeName, defaultVisible}]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt // cache-buster viewer (id tidak berubah saat upsert)
}

model LlmSession {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @unique // satu sesi per proyek -> upsert atomik, tanpa baris duplikat
  messages  Json // riwayat blok content utuh perencana <-> Claude (termasuk tool_use/tool_result)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Titik tur maket: pose kamera + frame diam 1280x720 hasil render viewer sendiri.
// Frame inilah jangkar fidelitas klip Seedance (first_frame / last_frame).
model TitikTur {
  id         String  @id @default(cuid())
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  urutan     Int // 0 = "Gambaran umum"
  nama       String
  deskripsi  String?
  featureId  Int? // bangunan terkait (kunci stats.features), opsional
  pos        Json // [x,y,z] koordinat adegan glTF
  target     Json // [x,y,z]
  framePath  String? // relatif STORAGE_DIR: {projectId}/tur/titik-{id}.png
  // Model3D.updatedAt saat frame diambil: beda dengan versi kini -> frame basi
  modelVersi String

  klipDari KlipTur[] @relation("KlipDari")
  klipKe   KlipTur[] @relation("KlipKe")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, urutan])
}

// Satu klip Seedance untuk ruas dari -> ke. Bukan ProcessingJob: activeKey di sana unik
// per PROYEK, sementara di sini satu job aktif per RUAS.
model KlipTur {
  id        String    @id @default(cuid())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  dari      TitikTur  @relation("KlipDari", fields: [dariId], references: [id], onDelete: Cascade)
  dariId    String
  ke        TitikTur  @relation("KlipKe", fields: [keId], references: [id], onDelete: Cascade)
  keId      String
  status    JobStatus @default(QUEUED)

  arkTaskId  String? // disimpan segera setelah task dibuat -> bisa dilanjutkan setelah restart
  model      String
  resolution String
  durasiDtk  Int
  prompt     String  @db.Text
  videoPath  String? // relatif STORAGE_DIR: {projectId}/tur/klip-{id}.mp4
  // sha1(pose kedua titik + modelVersi + PALET_VERSI + model/resolusi/durasi); beda dgn hash kini -> basi
  hashPose   String
  error      String?

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  // "dari:ke" selama QUEUED/RUNNING, null saat selesai: satu job aktif per ruas (atomik)
  activeKey String? @unique

  @@index([projectId, createdAt])
  @@index([dariId, keId])
  @@index([status])
}
